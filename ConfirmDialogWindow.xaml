<Window x:Class="DisplayBrightness.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#F4F5FA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#11131A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3D"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#8174F2"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5FA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A3A9BA"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F2B04C"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A3016"/>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#9488FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#6D61D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSubtleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#272B38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2F3542"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#353B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="{StaticResource WindowBrush}" BorderBrush="#313746" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.32" RenderingBias="Quality"/>
        </Border.Effect>

        <StackPanel Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource WarningSoftBrush}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{StaticResource WarningBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"
                                  Data="M12,3.5 L21.5,19.5 L2.5,19.5 Z"/>
                            <Path Stroke="{StaticResource WarningBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,10 L12,13.5 M12,16 L12.01,16"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock x:Name="MessageText" Margin="0,14,0,0" FontSize="12" LineHeight="18"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource DialogSubtleButtonStyle}"
                        Content="Cancel" Click="CancelButton_Click"/>
                <Button x:Name="RunButton" Grid.Column="2" Style="{StaticResource DialogPrimaryButtonStyle}"
                        Content="Run refresh" Click="RunButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
