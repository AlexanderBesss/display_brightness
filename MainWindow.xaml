<Window x:Class="DisplayBrightness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brightness"
        Width="404"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        Foreground="#F4F5FA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="WindowBrush" Color="#11131A"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181B24"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1C202A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3D"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#8174F2"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#2B2850"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5FA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A3A9BA"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#747B8F"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#252A36"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#303645"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#9488FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#6D61D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelProtectIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#D2CEFF"/>
            <Setter Property="Background" Value="#282548"/>
            <Setter Property="BorderBrush" Value="#5D568F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#35305E"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#211E3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="#303543"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center" Height="18">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="7" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="7" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#241F4B" Width="18" Height="18"/>
                                                    <Ellipse Fill="White" Width="10" Height="10"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack" Width="38" Height="22" CornerRadius="11" Background="#343A48" BorderBrush="#414858" BorderThickness="1">
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Margin="2" HorizontalAlignment="Left" Fill="#C8CDDA"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowChrome" Margin="20" Background="{StaticResource WindowBrush}" BorderBrush="#313746" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.32" RenderingBias="Quality"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="46" Margin="16,2,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource PrimarySoftBrush}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}"/>
                                <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Brightness" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTip="Hide to system tray" Click="CloseButton_Click">
                    <Path Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,5,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your displays" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding DisplayStatusText}" Margin="0,3,12,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}" ToolTip="Refresh displays and OLED status"
                        AutomationProperties.Name="Refresh displays and OLED status">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="White"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M9.5,3.2 A5,5 0 1 0 10.7,8 M9.5,3.2 L9.5,0.6 M9.5,3.2 L6.9,3.2"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0,20,0">
                <Grid>
                    <Border Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Visibility="{Binding NoMonitors, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="54" Height="54" Background="#232738" CornerRadius="16">
                                <Viewbox Width="25" Height="25">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Data="M3,4 L21,4 L21,16 L3,16 Z M8,20 L16,20 M12,16 L12,20"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="No displays found" Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Connect a compatible monitor and refresh." Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7" Padding="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" PreviewMouseWheel="MonitorCard_MouseWheel">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimarySoftBrush}">
                                                <Viewbox Width="18" Height="18">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                              Data="M3,4 L21,4 L21,16 L3,16 Z M8,20 L16,20 M12,16 L12,20"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <Grid Grid.Column="1" Margin="9,1,7,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="20" Height="20" Margin="0,0,5,0" VerticalAlignment="Center" Background="Transparent"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Main monitor — scroll the mouse wheel up/down over the tray icon to change its brightness">
                                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="#FFD700"
                                                          Data="M12,2 L14.4,8.8 L21.5,8.9 L15.8,13.2 L17.9,20.1 L12,16 L6.1,20.1 L8.2,13.2 L2.5,8.9 L9.6,8.8 Z"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Text="{Binding RefreshRateText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                                                                   Visibility="{Binding HasRefreshRate, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ModelName}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Column="2" MinWidth="40" Padding="7,3" VerticalAlignment="Center" Background="#272B38" CornerRadius="7">
                                                <TextBlock Text="{Binding BrightnessText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{StaticResource SubtleTextBrush}"
                                                  StrokeThickness="1.8" Data="M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1 M12,8 A4,4 0 1 1 11.9,8"/>
                                            <Slider Grid.Column="1" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                                    Value="{Binding BrightnessValue, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    PreviewMouseUp="Slider_MouseUp"/>
                                            <Path Grid.Column="2" Width="16" Height="16" Margin="9,0,0,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{StaticResource MutedTextBrush}"
                                                  StrokeThickness="1.8" Data="M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1 M12,7 A5,5 0 1 1 11.9,7"/>
                                        </Grid>

                                        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,9" Background="#171A22" CornerRadius="10"
                                                Visibility="{Binding ShowOledCare, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="OLED Care" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <Border Grid.Column="1" Margin="7,0,0,0" Padding="6,2" VerticalAlignment="Center" Background="#2B2850" CornerRadius="6">
                                                        <TextBlock Text="{Binding OledSupportText}" FontSize="8" FontWeight="SemiBold" Foreground="#AEA6FF"/>
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding OledStatusText}" FontSize="9.5"
                                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                    <Button Grid.Column="1" Style="{StaticResource PanelProtectIconButtonStyle}"
                                                            Command="{Binding RunPixelRefreshCommand}"
                                                            ToolTip="Run Panel Protect"
                                                            AutomationProperties.Name="Run Panel Protect">
                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="15" Text="&#xE83D;"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Margin="20,10,20,14" Padding="12,10" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Launch at startup" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Keep controls ready in the tray" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" IsChecked="{Binding StartOnStartup, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
